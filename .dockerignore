# Never ship internal/runtime artifacts to a distributed student image.
# (Note: plain *.log / *.error.log above are root-only in .dockerignore, so the
# recursive ** forms below are what actually catch src/cache, subdir logs, etc.)
AUDIT/
src/cache/
**/*.cache
**/*.log
**/*.error.log
